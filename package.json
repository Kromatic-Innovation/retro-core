    ".": "./lib/retro-core.mjs"
  },
  "files": [
    "lib/retro-core.mjs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kromatic-Innovation/retro-core.git"
  },
  "homepage": "https://github.com/Kromatic-Innovation/retro-core#readme",
  "bugs": {
    "url": "https://github.com/Kromatic-Innovation/retro-core/issues"
  },
  "author": "Kromatic Innovation (https://www.kromatic.com/)",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "check:resolve": "node scripts/check-resolve.mjs",
    "test": "node --test lib/retro-core.test.mjs scripts/check-resolve.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=lib/retro-core.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 lib/retro-core.test.mjs"
